# Copy to .env and fill in. .env is git-ignored: never commit a key.
# Rebuild and Trace need no model. Reading by eye and re-illustration use DeepSeek when this is set:
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# Or another OpenAI-compatible provider (a model that reads images):
# TELIOS_PROVIDER=gemini        # deepseek | gemini | openai | openrouter | ollama | custom
# TELIOS_MODEL=
# GEMINI_API_KEY=
# TELIOS_BASE_URL=              # custom only
# TELIOS_API_KEY=               # custom only

# TELIOS_EFFORT=high            # low | medium | high
# TELIOS_MAX_RENDERS=8

# ── Restyle: ComfyUI ──
# Beside a Phansora API (its ComfyUI and models; Telios installs nothing): its Talari address and
# a token for the account Telios calls as (in TALARI_LAB_USERS there), minted on that server with
# phansora.shared.auth.mint_user_token("telios", <seconds>).
# COMFYUI_API_URL=http://127.0.0.1:8000/talari
# COMFYUI_API_TOKEN=
# Or a ComfyUI already running (with FLUX.1 Dev and the ComfyUI-GGUF loader):
# COMFYUI_URL=http://127.0.0.1:8188
# With neither, `npm start` installs Telios's own ComfyUI into comfyui/ and fetches its models
# (about 12 GB, once); with Docker, COMPOSE_PROFILES=comfyui (docker-compose.prod.yml).
# FLUX_QUANT=Q4_K_S

# ── Signing in ──
# On a public address: the code the first visit asks for, to make the one account.
# TELIOS_SETUP_CODE=
